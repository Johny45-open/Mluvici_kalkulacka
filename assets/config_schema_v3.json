{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Johny45-open/Mluvici_kalkulacka/config_schema_v3.json",
  "title": "Mluvici kalkulacka config contract v3",
  "description": "Global speech, screen reader, theme, and result display settings are stored outside accessibility profiles.",
  "type": "object",
  "required": ["schemaVersion", "activeProfileId", "profiles", "globalSettings"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 3 },
    "createdAt": { "type": "string", "format": "date-time" },
    "generator": { "type": "string" },
    "calculatorCompatibility": { "type": "object" },
    "activeProfileId": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "isBuiltIn", "settings"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "isBuiltIn": { "type": "boolean" },
          "settings": {
            "type": "object",
            "required": [
              "accessibilityType", "fontSizeMultiplier", "dialogFontScale",
              "dotMatrixZoom", "resultZoom", "thousandGroupGap", "dialogSize",
              "useSixteenSegment", "usePeriodicNotation", "announceExpression",
              "readStatsMemoryValues", "autoReadStatsSummary",
              "showStatsNavigationHint", "alignInputLeft", "overlineThickness",
              "overlineHeight"
            ],
            "properties": {
              "accessibilityType": { "type": "string", "enum": ["none", "blind", "visuallyImpaired"] },
              "fontSizeMultiplier": { "type": "number", "minimum": 0.7, "maximum": 2.5 },
              "dialogFontScale": { "type": "number", "minimum": 0.5, "maximum": 5 },
              "dotMatrixZoom": { "type": "number", "minimum": 0.5, "maximum": 5 },
              "resultZoom": { "type": "number", "minimum": 0.5, "maximum": 5 },
              "thousandGroupGap": { "type": "string", "enum": ["small", "medium", "large"] },
              "dialogSize": { "type": "string", "enum": ["compact", "wide", "fullscreen"] },
              "useSixteenSegment": { "type": "boolean" },
              "usePeriodicNotation": { "type": "boolean" },
              "announceExpression": { "type": "boolean" },
              "readStatsMemoryValues": { "type": "boolean" },
              "autoReadStatsSummary": { "type": "boolean" },
              "showStatsNavigationHint": { "type": "boolean" },
              "alignInputLeft": { "type": "boolean" },
              "overlineThickness": { "type": "number", "minimum": 0.8, "maximum": 4 },
              "overlineHeight": { "type": "number", "minimum": 0.5, "maximum": 2 },
              "inverseFormatPreference": { "type": ["string", "null"], "enum": ["dms", "decimal", null] }
            }
          }
        }
      }
    },
    "globalSettings": {
      "type": "object",
      "required": [
        "screenReaderMode", "ttsEnabled", "speechRate", "speechVolume",
        "ttsEngine", "ttsVoice", "ttsVoiceName", "themeMode",
        "resultDisplayMode", "announceFractionAvailability", "showIntermediateStepsAutomatically", "isDegreeMode",
        "defaultMode", "resultNotationPreference", "historyExactFormat",
        "statsSummaryOrder", "statsComputedOrder", "statsDisplayConfig",
        "currency", "devMode"
      ],
      "properties": {
        "screenReaderMode": { "type": "string", "enum": ["auto", "on", "off"] },
        "ttsEnabled": { "type": "boolean" },
        "speechRate": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "speechVolume": { "type": "number", "minimum": 0, "maximum": 1 },
        "ttsEngine": { "type": ["string", "null"] },
        "ttsVoice": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["name", "locale"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "locale": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "ttsVoiceName": { "type": ["string", "null"] },
        "themeMode": { "type": "string", "enum": ["light", "dark"] },
        "resultDisplayMode": { "type": "string", "enum": ["segment", "text", "auto"] },
        "announceFractionAvailability": { "type": "boolean" },
        "showIntermediateStepsAutomatically": { "type": "boolean" },
        "isDegreeMode": { "type": "boolean" },
        "defaultMode": { "type": "string" },
        "resultNotationPreference": { "type": "string", "enum": ["decimal", "fraction"] },
        "historyExactFormat": { "type": "string", "enum": ["numeric", "exact"] },
        "statsSummaryOrder": { "type": "array" },
        "statsComputedOrder": { "type": "array" },
        "statsDisplayConfig": { "type": "object" },
        "currency": { "type": "object" },
        "devMode": { "type": "object" }
      }
    }
  }
}
